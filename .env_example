# Contoh konfigurasi. Salin menjadi .env lalu ganti semua nilai dummy di bawah:
#   cp .env_example .env          (Linux/macOS)
#   copy .env_example .env        (Windows)
# JANGAN commit file .env (sudah ada di .gitignore). Repo ini publik.

# Nama & versi aplikasi (tampil di pesan startup, /info, /version)
APP_NAME=bot monitoring ppp
APP_VERSION=2.3.0
RELEASED=23/11/2026
EMAIL=developer@example.com

# Token bot utama dari @BotFather (dipakai user)
TELEGRAM_BOT_TOKEN=0000000000:REPLACE_WITH_MAIN_BOT_TOKEN

# ID Telegram superadmin, dipisah koma (cek ID Anda lewat @userinfobot)
ALLOWED_ADMIN_IDS=100000001,100000002

# Bot kedua khusus log aktivitas + chat ID penerima log (admin atau grup log)
TELEGRAM_BOT_LOG_TOKEN=0000000000:REPLACE_WITH_LOG_BOT_TOKEN
LOG_USER_ID=100000001
